# Application Settings
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/worksphere

# Security Credentials
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@worksphere.com
SUPER_ADMIN_PASSWORD=your_super_admin_strong_password_here

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:3000

# ── Mail Configuration ────────────────────────────────────────────────────────
# Driver options: smtp | sendmail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
# Encryption options: tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@worksphere.com
MAIL_FROM_NAME=WorkSphere

# Invitation Settings
INVITATION_EXPIRES_DAYS=7

# ── Global Storage Configuration (Optional Development Fallback) ─────────────
BUNNY_STORAGE_ZONE=worksphere
BUNNY_STORAGE_ACCESS_KEY=your_bunny_storage_access_key
BUNNY_STORAGE_REGION=sg
BUNNY_PULL_ZONE_URL=https://worksphere.b-cdn.net
BUNNY_STORAGE_BASE_PATH=worksphere

# ── Google Calendar & Meet OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ── Microsoft 365 & Teams OAuth ──────────────────────────────────────────────
MS_CLIENT_ID=your_ms_client_id_here
MS_CLIENT_SECRET=your_ms_client_secret_here
MS_REDIRECT_URI=http://localhost:3000/oauth/callback
