# Application Settings
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/worksphere

# Security Credentials
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@worksphere.com
SUPER_ADMIN_PASSWORD=your_super_admin_strong_password_here

# Cross-Origin Resource Sharing
CORS_ORIGIN=http://localhost:3000

# ── Mail Configuration ────────────────────────────────────────────────────────
# Driver options: smtp | sendmail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
# Encryption options: tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@worksphere.com
MAIL_FROM_NAME=WorkSphere

# Invitation Settings
INVITATION_EXPIRES_DAYS=7
